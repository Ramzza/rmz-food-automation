{
  "name": "rmz-food-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k \"npm:server:dev\" \"npm:web:dev\"",
    "server:dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch server.ts",
    "web:dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "node node_modules/vite/bin/vite.js build",
    "build:server": "node node_modules/typescript/bin/tsc --project tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server.js",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  }
}
